# --- Database (Neon) ---
# Pooled connection string for app traffic (Neon: hostname contains -pooler)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Direct (unpooled) connection string — required by Prisma Migrate
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# --- Termii (mock-first: mock works with placeholders) ---
TERMII_MODE=mock
TERMII_API_KEY=placeholder
TERMII_BASE_URL=https://v4.api.termii.com
TERMII_DEVICE_ID=dev-placeholder
TERMII_TEMPLATE_ID=

# --- App ---
SESSION_SECRET=generate-a-long-random-string
JWT_SECRET=generate-another-long-random-string
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
