# Web app env template
# API base URL the browser calls (Express in dev, Render in prod).
# Next's rewrites proxy /api/* on this app to this origin, so the httpOnly
# admin session cookie stays same-origin for the UI.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Mono Connect public key (browser-safe). Empty = simulated "off" linking.
# In sandbox, use the test public key from app.mono.com.
NEXT_PUBLIC_MONO_PUBLIC_KEY=